        "functionCode": "// 組織對話數據\nconst thread = $('processThreads').item.json;\nconst messages = $input.item.json.data || [];\n\nreturn {\n  json: {\n    thread_id: thread.id,\n    created_at: thread.created_at,\n    messages: messages.map(msg => ({\n      role: msg.role,\n      content: msg.content[0].text.value,\n      created_at: msg.created_at\n    })),\n    filename: `openai_thread_${thread.id}_${new Date().toISOString().split('T')[0]}.json`\n  }\n};"
