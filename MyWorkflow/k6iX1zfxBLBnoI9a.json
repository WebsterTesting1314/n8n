    {
      "parameters": {
        "functionCode": "// 將各來源的 conversation 數組扁平化，並補充來源與時間戳\nconst allData = items.map(item => item.json);\n// 假設各來源均返回 { conversations: [ { id, content, timestamp, source } ] }\nlet conversations = [];\nallData.forEach(sourceData => {\n  if (sourceData.conversations && Array.isArray(sourceData.conversations)) {\n    conversations = conversations.concat(sourceData.conversations);\n  }\n});\n// 如有需要，可在此處為每條記錄補充來源信息\nconst processed = conversations.map(conv => ({\n  id: conv.id || Date.now().toString(),\n  content: conv.content,\n  source: conv.source || 'unknown',\n  timestamp: conv.timestamp || new Date().toISOString()\n}));\nreturn processed.map(conv => ({ json: conv }));"
      },
